{
  "name": "@mrbrunowolff/minimal-web-components",
  "version": "0.1.0",
  "private": false,
  "description": "A minimal Web Components starter kit using Lit, Vite, and TypeScript",
  "keywords": [
    "boilerplate",
    "custom-elements",
    "lit",
    "scaffold",
    "starter",
    "template",
    "typescript",
    "vite",
    "web-components"
  ],
  "license": "MIT",
  "author": "Bruno Wolff",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrBrunoWolff/minimal-web-components.git"
  },
  "bin": {
    "minimal-web-components": "bin/minimal-web-components.js"
  },
  "files": [
    "bin",
    "src",
    "__tests__",
    "index.html",
    "tsconfig.json",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "knip.config.ts",
    ".oxlintrc.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "check": "bun run --parallel --no-exit-on-error typecheck lint fmt:check knip",
    "knip": "knip --treat-config-hints-as-errors",
    "clean": "rm -rf node_modules/.vite dist playwright-report test-results",
    "audit": "bun audit --audit-level=high",
    "check:ci": "node scripts/quality.mjs",
    "check:code": "node scripts/quality.mjs code",
    "check:security": "node scripts/quality.mjs security"
  },
  "dependencies": {
    "lit": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/bun": "latest",
    "@vitest/browser": "latest",
    "@vitest/browser-playwright": "latest",
    "knip": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "terser": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "vitest-browser-lit": "latest"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.4.2"
}
